# Copy to .env.local (which is gitignored) and fill in.
#
# In dev this points at your local Express backend:
#   VITE_API_BASE_URL=http://localhost:4000
#
# In production it's the App Runner service URL:
#   VITE_API_BASE_URL=https://xxxxxxx.us-east-2.awsapprunner.com
VITE_API_BASE_URL=http://localhost:4000
